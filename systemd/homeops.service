[Unit]
Description=Home-Ops Automated Pipeline
StartLimitIntervalSec=10min
StartLimitBurst=5
# Create the static system user once:
#   sudo useradd --system --home /opt/home-ops --shell /usr/sbin/nologin homeops
# Provision the secure runtime layout:
#   sudo install -d -o homeops -g homeops -m 0750 /opt/home-ops/data
#   sudo install -o root -g homeops -m 0640 config/user_profile.yml /opt/home-ops/data/user_profile.yml
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homeops
Group=homeops
ExecStart=/usr/local/bin/homeops daemon
WorkingDirectory=/opt/home-ops
Environment=HOME_OPS_CONFIG=/opt/home-ops/data/user_profile.yml
Environment=HOME_OPS_DB_PATH=/opt/home-ops/data/home_ops.duckdb
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/opt/home-ops/data
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target